        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"fraud-detector-backend\",uri=~\"/api/.*\"}[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        }
      ]
    },
